# Reference copy of the rupeshpandey.dev block from the VPS Caddyfile at
# /opt/rupesh-data-workers/Caddyfile (which also hosts other subdomains).
# Apply changes there, then: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

rupeshpandey.dev {
	root * /srv/site
	encode zstd gzip
	try_files {path} /index.html

	@unversioned {
		not path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.otf *.webp *.glb *.gltf *.mp3 *.wasm
	}
	header @unversioned Cache-Control "no-cache, no-store, must-revalidate"

	@assets {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.otf *.webp *.glb *.gltf *.mp3 *.wasm
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	file_server {
		precompressed br
	}
}

www.rupeshpandey.dev {
	redir https://rupeshpandey.dev{uri} permanent
}
